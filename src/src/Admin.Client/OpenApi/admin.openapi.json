  "components": {
    "schemas": {
      "AdminHealthResponse": {
        "required": [
          "status",
          "timestampUtc",
          "transactionGuarantee",
          "supportsEventStreams",
          "supportsQueries",
          "supportsTransactionalOutbox",
          "operationalLimitations"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestampUtc": {
            "type": "string",
            "format": "date-time"
          },
          "transactionGuarantee": {
            "$ref": "#/components/schemas/EventStoreTransactionGuarantee"
          },
          "supportsEventStreams": {
            "type": "boolean"
          },
          "supportsQueries": {
            "type": "boolean"
          },
          "supportsTransactionalOutbox": {
            "type": "boolean"
          },
          "operationalLimitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AggregateSearchRequest": {
        "required": [
          "aggregateType",
          "aggregateId",
          "fromUtc",
          "toUtc",
          "isDeleted",
          "isRestored"
        ],
        "type": "object",
        "properties": {
          "aggregateType": {
            "maxLength": 256,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "aggregateId": {
            "maxLength": 256,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "fromUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "toUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isDeleted": {
            "type": "boolean"
          },
          "isRestored": {
            "type": "boolean"
          },
          "page": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "default": 1
          },
          "pageSize": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "default": 50
          },
          "sort": {
            "pattern": "^(?i)[A-Za-z][A-Za-z0-9_.]*\\s+(asc|desc)$",
            "type": "string",
            "default": "LastUpdatedUtc desc"
          }
        }
      },
      "AggregateSummaryResponse": {
        "required": [
          "aggregateType",
          "aggregateId",
          "currentVersion",
          "createdUtc",
          "lastUpdatedUtc",
          "isDeleted",
          "isRestored"
        ],
        "type": "object",
        "properties": {
          "aggregateType": {
            "type": "string"
          },
          "aggregateId": {
            "type": "string"
          },
          "currentVersion": {
            "type": "integer",
            "format": "int64"
          },
          "createdUtc": {
            "type": "string",
            "format": "date-time"
          },
          "lastUpdatedUtc": {
            "type": "string",
            "format": "date-time"
          },
          "isDeleted": {
            "type": "boolean"
          },
          "isRestored": {
            "type": "boolean"
          }
        }
      },
      "ConcurrencyGuarantee": {
        "type": "integer"
      },
      "EventContractCompatibilityStatus": {
        "type": "integer"
      },
      "EventContractManifestInfo": {
        "required": [
          "formatVersion",
          "json",
          "baselineJson",
          "compatibilityStatus"
        ],
        "type": "object",
        "properties": {
          "formatVersion": {
            "type": "integer",
            "format": "int32"
          },
          "json": {
            "type": "string"
          },
          "baselineJson": {
            "type": [
              "null",
              "string"
            ]
          },
          "compatibilityStatus": {
            "$ref": "#/components/schemas/EventContractCompatibilityStatus"
          }
        }
      },
      "EventEnvelopeResponse": {
        "required": [
          "aggregateType",
          "aggregateId",
          "metadata",
          "payload"
        ],
        "type": "object",
        "properties": {
          "aggregateType": {
            "type": "string"
          },
          "aggregateId": {
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/EventMetadataResponse"
          },
          "payload": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          }
        }
      },
      "EventMetadataResponse": {
        "required": [
          "version",
          "timestampUtc",
          "eventType",
          "schemaVersion",
          "correlationId",
          "causationId",
          "idempotencyId",
          "userId"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "timestampUtc": {
            "type": "string",
            "format": "date-time"
          },
          "eventType": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "integer",
            "format": "int32"
          },
          "correlationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "causationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "idempotencyId": {
            "type": [
              "null",
              "string"
            ]
          },
          "userId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EventStoreCapabilities": {
        "required": [
          "transactionGuarantee",
          "supportsEventStreams",
          "supportsSnapshots",
          "snapshotSchemaVersioning",
          "preservedMetadata",
          "supportsQueries",
          "supportsIdempotencyMarkers",
          "concurrency",
          "operationalLimitations"
        ],
        "type": "object",
        "properties": {
          "transactionGuarantee": {
            "$ref": "#/components/schemas/EventStoreTransactionGuarantee"
