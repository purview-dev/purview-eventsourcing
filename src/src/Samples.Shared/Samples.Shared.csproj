<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<!-- The SDK strips the 'Shared' suffix from the root namespace, so the derived assembly name would collide
		     with the Samples project (Purview.EventSourcing.Samples.dll). Keep the assemblies distinct. -->
		<AssemblyName>Purview.EventSourcing.Samples.Shared</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Validation.ZodSharp\Validation.ZodSharp.csproj" />
	</ItemGroup>
</Project>
